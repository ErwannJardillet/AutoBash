{
  "name": "autobash",
  "version": "1.0.2",
  "description": "Lanceur d'applications & sites web configurable",
  "type": "module",
  "scripts": {
    "build": "tsup src/cli.tsx --format esm --target node18 --outDir dist",
    "postbuild": "chmod +x dist/cli.js",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "tsup": "^8.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
