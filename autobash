#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════╗
# ║                    autobash v1.0.0                               ║
# ║          Lanceur d'apps & sites web configurable                 ║
# ╚══════════════════════════════════════════════════════════════════╝

set -euo pipefail
shopt -s nullglob

VERSION="1.0.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autobash"
PROFILES_DIR="$CONFIG_DIR/profiles"
SETTINGS_FILE="$CONFIG_DIR/settings.conf"

# ─── Couleurs & styles ────────────────────────────────────────────────────────
R='\033[0;31m'
G='\033[0;32m'
Y='\033[1;33m'
B='\033[0;34m'
C='\033[0;36m'
M='\033[0;35m'
W='\033[1;37m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ─── Helpers UI ───────────────────────────────────────────────────────────────
header() {
  echo ""
  echo -e "${BOLD}${C}┌──────────────────────────────────────────┐${NC}"
  echo -e "${BOLD}${C}│${NC}  ${BOLD}${W}autobash${NC} ${DIM}v${VERSION}${NC}$(printf '%*s' $((30 - ${#VERSION})) '')${BOLD}${C}│${NC}"
  echo -e "${BOLD}${C}└──────────────────────────────────────────┘${NC}"
  echo ""
}

section() {
  echo -e "\n${BOLD}${B}▸ $1${NC}\n"
}

success() { echo -e "  ${G}✔${NC}  $1"; }
warn()    { echo -e "  ${Y}⚠${NC}  $1"; }
error()   { echo -e "  ${R}✖${NC}  $1"; }
info()    { echo -e "  ${C}ℹ${NC}  $1"; }

prompt() {
  echo -ne "  ${BOLD}${W}$1${NC} "
}

separator() {
  echo -e "${DIM}  ─────────────────────────────────────────${NC}"
}

# Affiche un menu numéroté et retourne le choix dans $REPLY
menu() {
  local title="$1"
  shift
  local options=("$@")
  section "$title"
  local i=1
  for opt in "${options[@]}"; do
    echo -e "  ${BOLD}${Y}[$i]${NC} $opt"
    i=$(( i + 1 ))
  done
  echo -e "  ${BOLD}${Y}[0]${NC} ${DIM}Retour / Quitter${NC}"
  echo ""
  prompt "Choix :"
  read -r REPLY
}

# Confirmation oui/non
confirm() {
  prompt "$1 [o/N] :"
  read -r ans
  [[ "$ans" =~ ^[oOyY]$ ]]
}

# ─── Init config ──────────────────────────────────────────────────────────────
init_config() {
  mkdir -p "$PROFILES_DIR"
  if [[ ! -f "$SETTINGS_FILE" ]]; then
    cat > "$SETTINGS_FILE" << 'EOF'
# autobash — Paramètres globaux
# Navigateur utilisé pour les URLs (xdg-open, firefox, chromium, ...)
BROWSER=xdg-open
# Délai (secondes) entre chaque lancement
DELAY=0.3
# Profil lancé par défaut (nom de fichier sans .conf), vide = menu de sélection
DEFAULT_PROFILE=
EOF
    success "Config initialisée dans $CONFIG_DIR"
  fi
}

load_settings() {
  # Valeurs par défaut
  BROWSER="xdg-open"
  DELAY="0.3"
  DEFAULT_PROFILE=""
  # Charge le fichier (ignore les lignes de commentaire)
  if [[ -f "$SETTINGS_FILE" ]]; then
    # shellcheck source=/dev/null
    while IFS='=' read -r key val; do
      [[ "$key" =~ ^#.*$ || -z "$key" ]] && continue
      key="${key// /}"
      val="${val// /}"
      case "$key" in
        BROWSER)         BROWSER="$val" ;;
        DELAY)           DELAY="$val" ;;
        DEFAULT_PROFILE) DEFAULT_PROFILE="$val" ;;
      esac
    done < "$SETTINGS_FILE"
  fi
}

save_setting() {
  local key="$1"
  local val="$2"
  if grep -q "^${key}=" "$SETTINGS_FILE" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$SETTINGS_FILE"
  else
    echo "${key}=${val}" >> "$SETTINGS_FILE"
  fi
}

# ─── Gestion des profils ──────────────────────────────────────────────────────
# Format d'un profil (.conf) :
#   NAME=Mon Profil
#   DELAY=0.5           (optionnel, surcharge le global)
#   # type|label|commande_ou_url
#   app|VS Code|code
#   app|Terminal|gnome-terminal
#   url|GitHub|https://github.com
#   url|Gmail|https://mail.google.com

list_profiles() {
  local profiles=()
  local f
  for f in "$PROFILES_DIR"/*.conf; do
    [[ -f "$f" ]] || continue
    profiles+=("$(basename "$f" .conf)")
  done
  echo "${profiles[@]:-}"
}

profile_exists() {
  [[ -f "$PROFILES_DIR/$1.conf" ]]
}

get_profile_name() {
  local slug="$1"
  local name
  name=$(grep "^NAME=" "$PROFILES_DIR/$slug.conf" 2>/dev/null | cut -d= -f2- || true)
  echo "${name:-$slug}"
}

read_profile_items() {
  # Retourne les lignes d'items (type|label|cmd) d'un profil
  local slug="$1"
  grep -v "^#\|^NAME=\|^DELAY=\|^$" "$PROFILES_DIR/$slug.conf" 2>/dev/null || true
}

count_items() {
  local slug="$1"
  read_profile_items "$slug" | wc -l
}

# ─── Lancement ────────────────────────────────────────────────────────────────
launch_profile() {
  local slug="$1"
  local profile_file="$PROFILES_DIR/$slug.conf"

  if [[ ! -f "$profile_file" ]]; then
    error "Profil '$slug' introuvable."
    return 1
  fi

  local name
  name=$(get_profile_name "$slug")
  local delay="$DELAY"

  # Délai spécifique au profil ?
  local profile_delay
  profile_delay=$(grep "^DELAY=" "$profile_file" 2>/dev/null | cut -d= -f2- || true)
  if [[ -n "$profile_delay" ]]; then delay="$profile_delay"; fi

  header
  section "Lancement du profil : ${W}$name${NC}"

  local items
  items=$(read_profile_items "$slug")
  if [[ -z "$items" ]]; then
    warn "Ce profil est vide. Ajoutez des éléments via les paramètres."
    return 0
  fi

  local total
  total=$(echo "$items" | wc -l)
  local i=1

  while IFS='|' read -r type label cmd; do
    [[ -z "$type" ]] && continue
    echo -ne "  ${DIM}[$i/$total]${NC} ${BOLD}$label${NC} "

    case "$type" in
      url)
        echo -ne "${DIM}($cmd)${NC} "
        # Lance en arrière-plan ; on ne teste pas le code retour car xdg-open
        # peut retourner != 0 même si le lancement réussit
        ($BROWSER "$cmd" &>/dev/null 2>&1 &) || true
        echo -e "${G}✔${NC}"
        ;;
      app)
        echo -ne "${DIM}($cmd)${NC} "
        (eval "nohup $cmd" &>/dev/null 2>&1 &) || true
        echo -e "${G}✔${NC}"
        ;;
      *)
        echo -e "${Y}type inconnu${NC}"
        ;;
    esac

    i=$(( i + 1 ))
    if [[ "$delay" != "0" && $i -le $total ]]; then
      sleep "$delay"
    fi
  done <<< "$items"

  echo ""
  success "$total élément(s) lancé(s) depuis le profil '${name}'."
  echo ""
}

# ─── Paramètres globaux ───────────────────────────────────────────────────────
settings_global() {
  while true; do
    load_settings
    header
    section "Paramètres globaux"
    echo -e "  Navigateur   : ${W}${BROWSER}${NC}"
    echo -e "  Délai global : ${W}${DELAY}s${NC}"
    echo -e "  Profil déf.  : ${W}${DEFAULT_PROFILE:-aucun (menu)}${NC}"
    separator

    menu "Modifier" \
      "Changer le navigateur  (actuel: ${BROWSER})" \
      "Changer le délai       (actuel: ${DELAY}s)" \
      "Changer le profil par défaut"

    case "$REPLY" in
      1)
        prompt "Navigateur (ex: firefox, chromium, xdg-open) :"
        read -r new_browser
        if [[ -n "$new_browser" ]]; then save_setting "BROWSER" "$new_browser" && success "Navigateur mis à jour."; fi
        ;;
      2)
        prompt "Délai en secondes (ex: 0.5, 1, 0) :"
        read -r new_delay
        if [[ "$new_delay" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
          save_setting "DELAY" "$new_delay"
          success "Délai mis à jour."
        else
          error "Valeur invalide."
        fi
        ;;
      3)
        local profiles=()
        IFS=' ' read -ra profiles <<< "$(list_profiles)"
        if [[ ${#profiles[@]} -eq 0 || -z "${profiles[0]}" ]]; then
          warn "Aucun profil créé."
        else
          echo ""
          echo -e "  ${BOLD}${Y}[0]${NC} Aucun (afficher le menu au lancement)"
          local j=1
          for p in "${profiles[@]}"; do
            echo -e "  ${BOLD}${Y}[$j]${NC} $(get_profile_name "$p") ${DIM}($p)${NC}"
            j=$(( j + 1 ))
          done
          echo ""
          prompt "Choisir le profil par défaut :"
          read -r pidx
          if [[ "$pidx" == "0" ]]; then
            save_setting "DEFAULT_PROFILE" ""
            success "Pas de profil par défaut."
          elif [[ "$pidx" =~ ^[0-9]+$ && "$pidx" -le "${#profiles[@]}" ]]; then
            local chosen="${profiles[$((pidx-1))]}"
            save_setting "DEFAULT_PROFILE" "$chosen"
            success "Profil par défaut : $(get_profile_name "$chosen")"
          else
            error "Choix invalide."
          fi
        fi
        ;;
      0) return ;;
      *) error "Choix invalide." ;;
    esac
    sleep 0.8
  done
}

# ─── Édition d'un profil ──────────────────────────────────────────────────────
edit_profile() {
  local slug="$1"
  local profile_file="$PROFILES_DIR/$slug.conf"

  while true; do
    header
    local name
    name=$(get_profile_name "$slug")
    section "Profil : ${W}$name${NC}"

    # Lire et afficher les items
    local items_raw
    items_raw=$(read_profile_items "$slug")
    local item_count=0

    if [[ -n "$items_raw" ]]; then
      local i=1
      while IFS='|' read -r type label cmd; do
        [[ -z "$type" ]] && continue
        local icon="🔗"
        if [[ "$type" == "app" ]]; then icon="⚙ "; fi
        echo -e "  ${DIM}[$i]${NC} ${icon} ${BOLD}$label${NC} ${DIM}→ $cmd${NC}"
        i=$(( i + 1 )); item_count=$(( item_count + 1 ))
      done <<< "$items_raw"
    else
      warn "Profil vide."
    fi

    separator
    menu "Actions" \
      "Ajouter un site web (URL)" \
      "Ajouter une application" \
      "Supprimer un élément" \
      "Renommer le profil" \
      "Changer le délai du profil" \
      "Supprimer ce profil"

    case "$REPLY" in
      1)
        prompt "Nom affiché (ex: GitHub) :"
        read -r label
        prompt "URL complète (ex: https://github.com) :"
        read -r url
        if [[ -n "$label" && -n "$url" ]]; then
          echo "url|$label|$url" >> "$profile_file"
          success "URL '$label' ajoutée."
        else
          error "Nom ou URL manquant."
        fi
        ;;
      2)
        prompt "Nom affiché (ex: VS Code) :"
        read -r label
        prompt "Commande shell (ex: code, firefox, spotify) :"
        read -r cmd
        if [[ -n "$label" && -n "$cmd" ]]; then
          echo "app|$label|$cmd" >> "$profile_file"
          success "Application '$label' ajoutée."
        else
          error "Nom ou commande manquant."
        fi
        ;;
      3)
        if [[ $item_count -eq 0 ]]; then
          warn "Aucun élément à supprimer."
        else
          prompt "Numéro de l'élément à supprimer :"
          read -r del_idx
          if [[ "$del_idx" =~ ^[0-9]+$ && $del_idx -ge 1 && $del_idx -le $item_count ]]; then
            # Reconstruire le fichier sans la ligne correspondante
            local tmp_file
            tmp_file=$(mktemp)
            # Copier header (NAME=, DELAY=, commentaires)
            grep "^#\|^NAME=\|^DELAY=\|^$" "$profile_file" > "$tmp_file" || true
            # Copier les items sauf celui supprimé
            local ci=1
            while IFS='|' read -r type label cmd; do
              [[ -z "$type" ]] && continue
              if [[ $ci -ne $del_idx ]]; then
                echo "$type|$label|$cmd" >> "$tmp_file"
              fi
              ci=$(( ci + 1 ))
            done <<< "$items_raw"
            mv "$tmp_file" "$profile_file"
            success "Élément supprimé."
          else
            error "Numéro invalide."
          fi
        fi
        ;;
      4)
        prompt "Nouveau nom du profil :"
        read -r new_name
        if [[ -n "$new_name" ]]; then
          sed -i "s|^NAME=.*|NAME=$new_name|" "$profile_file"
          success "Profil renommé en '$new_name'."
        fi
        ;;
      5)
        prompt "Délai spécifique pour ce profil en secondes (vide = utiliser le global) :"
        read -r p_delay
        if [[ -z "$p_delay" ]]; then
          sed -i '/^DELAY=/d' "$profile_file"
          success "Délai spécifique supprimé (délai global utilisé)."
        elif [[ "$p_delay" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
          if grep -q "^DELAY=" "$profile_file"; then
            sed -i "s|^DELAY=.*|DELAY=$p_delay|" "$profile_file"
          else
            sed -i "1a DELAY=$p_delay" "$profile_file"
          fi
          success "Délai du profil : ${p_delay}s"
        else
          error "Valeur invalide."
        fi
        ;;
      6)
        if confirm "Supprimer définitivement le profil '$name' ?"; then
          rm -f "$profile_file"
          success "Profil '$name' supprimé."
          sleep 0.8
          return
        fi
        ;;
      0) return ;;
      *) error "Choix invalide." ;;
    esac
    sleep 0.6
  done
}

# ─── Création d'un profil ─────────────────────────────────────────────────────
create_profile() {
  header
  section "Créer un nouveau profil"

  prompt "Nom du profil (ex: Travail, Perso, Dev) :"
  read -r name
  if [[ -z "$name" ]]; then error "Nom vide."; return 1; fi

  # Générer un slug à partir du nom
  local slug
  slug=$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd 'a-z0-9-')

  # Éviter les doublons de slug
  local base_slug="$slug"
  local counter=1
  while profile_exists "$slug"; do
    slug="${base_slug}-${counter}"
    counter=$(( counter + 1 ))
  done

  cat > "$PROFILES_DIR/$slug.conf" << EOF
# Profil autobash : $name
NAME=$name
# DELAY=0.5  (décommenter pour surcharger le délai global)
EOF

  success "Profil '${name}' créé (slug: ${slug})."
  sleep 0.6

  if confirm "Ajouter des éléments maintenant ?"; then
    edit_profile "$slug"
  fi
}

# ─── Gestionnaire de profils ──────────────────────────────────────────────────
manage_profiles() {
  while true; do
    header
    section "Gestion des profils"

    local profiles=()
    IFS=' ' read -ra profiles <<< "$(list_profiles)"

    if [[ ${#profiles[@]} -eq 0 || -z "${profiles[0]}" ]]; then
      warn "Aucun profil créé."
      separator
      menu "Options" "Créer un nouveau profil"
      case "$REPLY" in
        1) create_profile ;;
        0) return ;;
      esac
      continue
    fi

    local i=1
    for p in "${profiles[@]}"; do
      local n count
      n=$(get_profile_name "$p")
      count=$(count_items "$p")
      echo -e "  ${BOLD}${Y}[$i]${NC} ${BOLD}$n${NC} ${DIM}($count élément(s))${NC}"
      i=$(( i + 1 ))
    done

    separator
    menu "Options" \
      "Éditer un profil" \
      "Créer un nouveau profil" \
      "Lancer un profil"

    case "$REPLY" in
      1)
        prompt "Numéro du profil à éditer :"
        read -r pidx
        if [[ "$pidx" =~ ^[0-9]+$ && $pidx -ge 1 && $pidx -le ${#profiles[@]} ]]; then
          edit_profile "${profiles[$((pidx-1))]}"
        else
          error "Numéro invalide."
          sleep 0.5
        fi
        ;;
      2) create_profile ;;
      3)
        prompt "Numéro du profil à lancer :"
        read -r pidx
        if [[ "$pidx" =~ ^[0-9]+$ && $pidx -ge 1 && $pidx -le ${#profiles[@]} ]]; then
          load_settings
          launch_profile "${profiles[$((pidx-1))]}"
          read -rp "  Appuyer sur Entrée pour continuer..."
        else
          error "Numéro invalide."
          sleep 0.5
        fi
        ;;
      0) return ;;
      *) error "Choix invalide." ; sleep 0.5 ;;
    esac
  done
}

# ─── Menu principal ───────────────────────────────────────────────────────────
main_menu() {
  while true; do
    header

    local profiles=()
    IFS=' ' read -ra profiles <<< "$(list_profiles)"

    if [[ ${#profiles[@]} -gt 0 && -n "${profiles[0]}" ]]; then
      section "Profils disponibles"
      local i=1
      for p in "${profiles[@]}"; do
        local n count
        n=$(get_profile_name "$p")
        count=$(count_items "$p")
        echo -e "  ${BOLD}${G}[$i]${NC} ${BOLD}$n${NC} ${DIM}($count élément(s))${NC}"
        i=$(( i + 1 ))
      done
      separator
    else
      warn "Aucun profil. Créez-en un dans les paramètres."
      separator
    fi

    local base_options=("Paramètres" "Gérer les profils")
    menu "Navigation" "${base_options[@]}"

    local profile_count=${#profiles[@]}
    if [[ -n "${profiles[0]:-}" && "$REPLY" =~ ^[0-9]+$ && "$REPLY" -ge 1 && "$REPLY" -le $profile_count ]]; then
      load_settings
      launch_profile "${profiles[$((REPLY-1))]}"
      read -rp "  Appuyer sur Entrée pour continuer..."
    else
      # Les options de menu commencent après les profils
      local offset=$((profile_count))
      case "$REPLY" in
        $((offset+1))) settings_global ;;
        $((offset+2))) manage_profiles ;;
        0) echo -e "\n  ${DIM}À bientôt !${NC}\n"; exit 0 ;;
        *) error "Choix invalide." ; sleep 0.5 ;;
      esac
    fi
  done
}

# ─── Aide ─────────────────────────────────────────────────────────────────────
show_help() {
  header
  echo -e "  ${BOLD}Usage :${NC}  autobash [OPTIONS] [PROFIL]"
  echo ""
  echo -e "  ${BOLD}Arguments :${NC}"
  echo -e "    ${Y}[PROFIL]${NC}         Lance directement le profil (slug ou nom)"
  echo ""
  echo -e "  ${BOLD}Options :${NC}"
  echo -e "    ${Y}-s, --settings${NC}   Ouvre les paramètres globaux"
  echo -e "    ${Y}-p, --profiles${NC}   Gestion des profils"
  echo -e "    ${Y}-l, --list${NC}       Liste tous les profils"
  echo -e "    ${Y}-n, --new${NC}        Crée un nouveau profil"
  echo -e "    ${Y}-h, --help${NC}       Affiche cette aide"
  echo -e "    ${Y}-v, --version${NC}    Affiche la version"
  echo ""
  echo -e "  ${BOLD}Exemples :${NC}"
  echo -e "    ${DIM}autobash${NC}               → Menu principal"
  echo -e "    ${DIM}autobash travail${NC}        → Lance le profil 'travail'"
  echo -e "    ${DIM}autobash --new${NC}          → Crée un profil"
  echo -e "    ${DIM}autobash --list${NC}         → Liste les profils"
  echo ""
  echo -e "  ${BOLD}Config :${NC}  ${DIM}${CONFIG_DIR}${NC}"
  echo ""
}

list_all_profiles() {
  header
  local profiles=()
  IFS=' ' read -ra profiles <<< "$(list_profiles)"
  if [[ ${#profiles[@]} -eq 0 || -z "${profiles[0]}" ]]; then
    warn "Aucun profil créé."
  else
    section "Profils disponibles"
    for p in "${profiles[@]}"; do
      local n count
      n=$(get_profile_name "$p")
      count=$(count_items "$p")
      echo -e "  ${G}•${NC} ${BOLD}$n${NC} ${DIM}(slug: $p, $count élément(s))${NC}"
    done
  fi
  echo ""
}

# ─── Recherche de profil par nom ─────────────────────────────────────────────
_find_profile_by_name() {
  local query="$1"
  local found=""
  local all_profiles=()
  IFS=' ' read -ra all_profiles <<< "$(list_profiles)"
  local p n
  for p in "${all_profiles[@]}"; do
    n=$(get_profile_name "$p")
    if [[ "${n,,}" == "${query,,}" ]]; then
      found="$p"
      break
    fi
  done
  if [[ -n "$found" ]]; then
    launch_profile "$found"
  else
    error "Profil '$query' introuvable."
    echo ""
    info "Utilisez ${BOLD}autobash --list${NC} pour voir les profils disponibles."
    echo ""
    exit 1
  fi
}

# ─── Entry point ──────────────────────────────────────────────────────────────
init_config
load_settings

case "${1:-}" in
  -h|--help)    show_help ;;
  -v|--version) echo "autobash v${VERSION}" ;;
  -s|--settings) header; settings_global ;;
  -p|--profiles) manage_profiles ;;
  -l|--list)    list_all_profiles ;;
  -n|--new)     header; create_profile ;;
  "")
    # Profil par défaut défini ?
    if [[ -n "$DEFAULT_PROFILE" ]] && profile_exists "$DEFAULT_PROFILE"; then
      launch_profile "$DEFAULT_PROFILE"
    else
      main_menu
    fi
    ;;
  *)
    # Chercher le profil par slug exact ou par nom
    if profile_exists "$1"; then
      launch_profile "$1"
    else
      _find_profile_by_name "$1"
    fi
    ;;
esac
